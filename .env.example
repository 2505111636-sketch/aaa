# npm run setup generates the local .env with a private owner password.
DATABASE_DRIVER=sqlite
DATABASE_PATH=data/route-rescue.sqlite
ADMIN_PASSWORD=
PORT=3000
HOST=0.0.0.0

# Set this behind an HTTPS reverse proxy, e.g. https://your-domain.example
# PUBLIC_ORIGIN=

